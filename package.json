{
  "name": "plantopedia",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@clerk/expo": "4.11.0",
    "@expo/vector-icons": "^15.0.2",
    "@plantopedia/contracts": "0.1.0",
    "@tanstack/react-query": "5.104.3",
    "expo": "~57.0.29",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/jest": "0.2.39",
    "@testing-library/react-native": "13.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/react": "~19.2.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-json-file.mjs && node scripts/patch-teeny-request.mjs && node scripts/patch-expo-launch-target.mjs",
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "start:preview": "expo start --go",
    "web": "expo start --web",
    "ios": "node scripts/eas-build.mjs build --profile development --platform ios",
    "android": "node scripts/eas-build.mjs build --profile development --platform android",
    "build:contracts": "npm run build -w @plantopedia/contracts",
    "build:api": "npm run build:contracts && npm run build -w @plantopedia/server",
    "start:api": "npm run start -w @plantopedia/server",
    "dev:api": "npm run dev -w @plantopedia/server",
    "typecheck": "npm run build:contracts && tsc --noEmit && npm run typecheck -w @plantopedia/server",
    "lint": "eslint .",
    "heroku-postbuild": "npm run build:api",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.server.config.cjs tests/unit --runInBand && node --test tests/scripts/*.test.mjs",
    "test:functional": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.server.config.cjs server/tests --runInBand",
    "test:components": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.mobile.config.cjs --runInBand",
    "test": "npm run test:unit && npm run test:functional && npm run test:components",
    "format": "prettier --write src server/src server/tests packages/contracts/src tests app.config.ts",
    "eas-build-post-install": "npm run build:contracts",
    "test:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "deploy:api": "node scripts/deploy-heroku.mjs",
    "build:mobile": "node scripts/eas-build.mjs"
  },
  "private": true,
  "plantopedia": {
    "defaultRuntime": "expo-go"
  },
  "workspaces": [
    "server",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "npm@12.0.2"
}
