# ---------------------- Expo and Clerk configuration ----------------------
# Values are case-sensitive; boolean settings accept only true or false, not 1/0.
# Only EXPO_PUBLIC_* values belong in the mobile app; keep other credentials server-side.
# Public mobile configuration: visible to everyone who installs the app.
# API origin, without /v1: HTTPS, or local HTTP at 127.0.0.1/localhost.
# A physical phone needs a reachable HTTPS endpoint; loopback points to the phone.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
# Local development only: Expo starts/checks the loopback API automatically.
# Set false only when deliberately managing the API in a separate terminal.
# Hosted HTTPS APIs, CI, production and exports never auto-start a local API.
PLANTOPEDIA_AUTO_START_API=true
# Optional phone testing: npx expo start also owns a temporary Cloudflare HTTPS
# tunnel to the Clerk-authenticated local API. Requires installed cloudflared.
# The public URL changes each launch; reload Expo Go. Never used by builds/CI.
# See notes/phone-capture-recovery.md before enabling; no private keys enter the app.
PLANTOPEDIA_PHONE_API=false
# Public Clerk key: pk_test_... (development) or pk_live_... (production).
# Use the same Clerk instance as CLERK_SECRET_KEY and CLERK_ISSUER_URL.
# Expo requires EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY; NEXT_PUBLIC_ is for Next.js.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_me
# Optional for local development; required for the production vercel.app proxy.
EXPO_PUBLIC_CLERK_PROXY_URL=
# Server copy of the matching public key, required when CLERK_PROXY_URL is set.
CLERK_PUBLISHABLE_KEY=
# Private Clerk key: sk_test_... or sk_live_... from the matching Clerk instance.
# Required for authenticated API use, including demo-provider mode.
CLERK_SECRET_KEY=replace_me
# Exact Clerk token issuer URL, e.g. https://your-instance.clerk.accounts.dev.
# Must match the session token iss claim; not your API or app URL.
# Include https:// before the hostname; omit trailing slashes, paths, and queries.
CLERK_ISSUER_URL=https://replace-with-your-clerk-issuer
# Optional local proxy; production: https://plantopedia-nine.vercel.app/__clerk.
CLERK_PROXY_URL=

# ---------------------- Server configuration ----------------------
# Runtime mode: development (default), production, or test (automated tests only).
# Does not automatically change provider, Firebase, or tracing settings.
NODE_ENV=development
# API bind address: 127.0.0.1 (local only, default) or 0.0.0.0 (all interfaces).
SERVER_HOST=127.0.0.1
# API listening port: integer 1-65535; default 3001. Hosting may inject this.
PORT=3001
# Comma-separated exact web origins allowed by HTTP CORS and voice WebSockets.
# Localhost HTTP previews remain allowed. No wildcards, paths or trailing slashes.
# Include the API origin for native WebSockets (Android sends that Origin too).
# Example: https://plantopedia.example.com,https://api.example.com
# Phone-browser camera/microphone access requires a trusted HTTPS web origin.
WEB_ALLOWED_ORIGINS=
# false (default): demo identification/text, no web research, voice disabled.
# true: real PlantNet/OpenAI/Tavily calls; all three API keys required; may incur charges.
# Does not disable Clerk, Firebase, or separately enabled tracing.
ALLOW_LIVE_PROVIDERS=false

# ---------------------- PlantNet and Tavily ----------------------
# Private Pl@ntNet identification API key; required only when live providers are enabled.
PLANTNET_API_KEY=replace_me
# PlantNet flora/project ID: all (default), or a supported ID using letters, digits, _ or -.
# This selects a plant catalog, not your Firebase project or application name.
PLANTNET_PROJECT=all
# Private OpenAI API key for voice, assistant, photo reasoning, and embeddings.
# Required only when live providers are enabled; keep server-side.
OPENAI_API_KEY=replace_me
# Voice model: only gpt-realtime-2.1 is accepted by the current app; requires account access.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OpenAI model ID for text and photo reasoning; default gpt-6-luna.
# Choose an account-accessible model supporting Responses, image input, and tool calls.
OPENAI_BACKEND_MODEL=gpt-6-luna
# OpenAI embedding model ID for saved-memory search; default text-embedding-3-small.
# Must support OPENAI_EMBEDDING_DIMENSIONS; changing models requires reindexing memory.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector size: integer 1-2048; default 1536.
# Must match the model output and Firestore vector index (committed index: 1536).
OPENAI_EMBEDDING_DIMENSIONS=1536
# Private Tavily web-search API key; required only when live providers are enabled.
TAVILY_API_KEY=replace_me

# Safe local Firebase mode; Admin credentials unused with emulators.
# For hosted Firebase, set USE_FIREBASE_EMULATORS=false and clear BOTH host values below.
# true (default): use running local Firestore/Storage emulators with a demo- project.
# false: use hosted Firebase; remove/empty both emulator host variables.
USE_FIREBASE_EMULATORS=true
# Firebase project ID, not its display name: demo-... for emulators; actual ID for hosted.
FIREBASE_PROJECT_ID=demo-plantopedia
# Firestore database ID, separate from the project ID. Set a named database
# explicitly (for example plantopedia-db); otherwise the SDK uses (default).
FIRESTORE_DATABASE_ID="(default)"
# Storage bucket name only, without gs://: e.g. PROJECT.firebasestorage.app.
# Use the exact configured bucket; older projects may use PROJECT.appspot.com.
FIREBASE_STORAGE_BUCKET=demo-plantopedia.firebasestorage.app
# Firestore emulator host: 127.0.0.1:PORT, no http:// (typically 127.0.0.1:8080).
# Required in emulator mode; remove/leave blank for hosted Firebase.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Storage emulator host: 127.0.0.1:PORT, no http:// (typically 127.0.0.1:9199).
# Required in emulator mode; remove/leave blank for hosted Firebase.
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Firebase service-account client_email, e.g. NAME@PROJECT.iam.gserviceaccount.com.
# Leave blank with emulators or configured application-default identity; otherwise set with private key.
FIREBASE_CLIENT_EMAIL=
# Matching service-account PEM private_key; quote it and preserve escaped \n newlines.
# Copy private_key, not private_key_id; include the BEGIN/END PRIVATE KEY lines.
# Hosted startup requires a valid RSA PEM key; a short key ID cannot authenticate.
# Leave blank with emulators or configured application-default identity; keep server-side.
FIREBASE_PRIVATE_KEY=

# Server tracing: choose the endpoint for the actual workspace region.
# false (default): no app traces; true: send redacted metadata to LangSmith.
# Independent of ALLOW_LIVE_PROVIDERS; true requires LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
# Private LangSmith tracing API key; required only when LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=replace_me
# LangSmith trace group/project name; default plantopedia-local (not a Firebase ID).
LANGSMITH_PROJECT=plantopedia-local
# LangSmith API URL for your workspace region; default https://api.smith.langchain.com.
# For EU workspaces use https://eu.api.smith.langchain.com; not the dashboard URL.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangSmith workspace ID from workspace settings, or blank if the key selects one.
# Set it when the API key can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Must be true: hides trace inputs. false is rejected to protect private data.
LANGSMITH_HIDE_INPUTS=true
# Must be true: hides trace outputs. false is rejected to protect private data.
LANGSMITH_HIDE_OUTPUTS=true
